# =================================================================
# Zero Trust API Security Gateway - Environment Configuration (.env)
# Copy this file to .env and replace placeholders with actual values
# =================================================================

# --------------------------------------------------
# Gateway Server Settings
# --------------------------------------------------
ENVIRONMENT=Production
NODE_ENV=production
PORT=5501
HOST=0.0.0.0
SYSTEM_NAME="Zero-Trust API Security Gateway"
API_BASE_URL=https://api.yourdomain.com
WS_URL=wss://api.yourdomain.com/ws
SESSION_TIMEOUT_MINUTES=60

# --------------------------------------------------
# Authentication & Cryptographic Keys
# --------------------------------------------------
JWT_SECRET=your-256-bit-secret-key-change-in-production
JWT_ALGORITHM=RS256
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
ENFORCE_MFA=true
BLOCK_UNKNOWN_DEVICES=true

# --------------------------------------------------
# SSL / TLS Certificates
# --------------------------------------------------
SSL_CERT_PATH=/etc/ssl/certs/gateway.crt
SSL_KEY_PATH=/etc/ssl/private/gateway.key
SSL_CA_PATH=/etc/ssl/certs/ca-bundle.crt

# --------------------------------------------------
# Database Configuration
# --------------------------------------------------
DATABASE_URL=postgresql://gateway_user:change_this_password@localhost:5432/zerotrust_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zerotrust_db
DB_USER=gateway_user
DB_PASSWORD=change_this_password

# --------------------------------------------------
# In-Memory Cache & Session Store (Redis)
# --------------------------------------------------
REDIS_URL=redis://:change_this_redis_password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password

# --------------------------------------------------
# Data Retention (Days)
# --------------------------------------------------
LOG_RETENTION_DAYS=30
INCIDENT_RETENTION_DAYS=90
AUTO_CLEANUP_OLD_DATA=true

# --------------------------------------------------
# Threat Intelligence & Anomaly Detection
# --------------------------------------------------
ENABLE_REALTIME_MONITORING=true
ENABLE_ML_ANOMALY_DETECTION=true
ANOMALY_SCORE_THRESHOLD=0.70
GEOLOCATION_ANALYSIS=true
AUTOMATED_THREAT_RESPONSE=true
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --------------------------------------------------
# Alerting & Notifications
# --------------------------------------------------
CRITICAL_THREAT_ALERTS=true
HIGH_RISK_ALERTS=true
ALERT_THRESHOLD="High and Critical Only"
NOTIFICATION_FREQUENCY="Real-time"
NOTIFICATION_RECIPIENTS="admin@example.com, security@example.com"

# Email / SMTP Settings
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=alerts@yourdomain.com

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

